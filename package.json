{
  "name": "@dacodedbeat/mcp-browser-buddy",
  "version": "0.0.1",
  "description": "MCP server for browser control, tab management, and automation (currently Chrome-based)",
  "keywords": [
    "browser",
    "chrome",
    "mcp",
    "tabs"
  ],
  "license": "MIT",
  "author": "dacodedbeat",
  "repository": {
    "type": "git",
    "url": "https://github.com/DAcodedBEAT/mcp-browser-buddy.git"
  },
  "bin": {
    "mcp-browser-buddy": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "node --experimental-strip-types src/index.ts",
    "build": "tsc && chmod +x dist/index.js",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build",
    "test": "vitest run",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "prepack": "npm run typecheck && npm run lint && npm run format:check && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.91.0",
    "semantic-release": "^25.0.5",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=23.6.0"
  }
}
