{
  "name": "@dacodedbeat/mcp-browser-buddy",
  "version": "0.0.1",
  "description": "MCP server for browser control, tab management, and automation (currently Chrome-based)",
  "keywords": [
    "browser",
    "chrome",
    "mcp",
    "tabs"
  ],
  "license": "MIT",
  "author": "dacodedbeat",
  "repository": {
    "type": "git",
    "url": "https://github.com/DAcodedBEAT/mcp-browser-buddy.git"
  },
  "bin": {
    "mcp-browser-buddy": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "node --experimental-strip-types src/index.ts",
    "build": "tsc && chmod +x dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "prepack": "npm run typecheck && npm run lint && npm run format:check && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.13.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "oxfmt": "^0.54.0",
    "oxlint": "^1.69.0",
    "semantic-release": "^25.0.5",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=23.6.0"
  }
}
